# ─── Copy this file to server/config/.env and fill in your values ───────────
# NEVER commit .env to git. It is listed in .gitignore.

# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_dashboard
DB_USER=postgres
DB_PASSWORD=your_password_here

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# StayNTouch SFTP (Phase 3)
SFTP_HOST=sftp.stayntouch.com
SFTP_PORT=22
SFTP_USER=your_sftp_username
SFTP_PASSWORD=your_sftp_password
# OR use a private key:
SFTP_PRIVATE_KEY_PATH=/path/to/id_rsa
SFTP_BOTB_FOLDER=/exports/business-on-books
SFTP_PRODUCTION_FOLDER=/exports/production-by-rate
SFTP_POLL_INTERVAL_MINUTES=60

# StayNTouch REST API (Phase 3 Option B)
STAYNTOUCH_API_BASE=https://api.stayntouch.com/v1
STAYNTOUCH_CLIENT_ID=your_client_id
STAYNTOUCH_CLIENT_SECRET=your_client_secret
STAYNTOUCH_PROPERTY_ID=your_property_id

# Licensing
LICENSE_SECRET=replace_with_another_long_random_string
